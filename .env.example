# Razorpay Webhook Configuration
RAZORPAY_WEBHOOK_SECRET="whsec_test_secret_12345"

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost/lifeline_db"

# LLM Reasoning Engine (On-Prem Ollama / Zero-Data Leakage or Groq Cloud)
LLM_PROVIDER="ollama"                  # "ollama" for local private inference, or "groq" for cloud
OLLAMA_MODEL="llama3.2:3b"             # e.g. "llama3.2:3b" or "llama3.2:1b"
OLLAMA_BASE_URL="http://localhost:11434"
GROQ_API_KEY="your_groq_api_key_here"  # Get free at console.groq.com (fallback mock active if unset)

# Razorpay Test-Mode API Keys
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_key_secret"

# Inbound & Outbound SMS Gateway (httpSMS)
HTTPSMS_API_KEY="test_key"
HTTPSMS_FROM_NUMBER="+1234567890"

# Permanent Ngrok Static Domain (Claim free at dashboard.ngrok.com/endpoints)
NGROK_STATIC_DOMAIN=""  # e.g. "your-static-subdomain.ngrok-free.app"

# Multi-Channel WhatsApp Delivery (Evolution API via Docker)
WHATSAPP_ENABLED="true"
EVOLUTION_API_URL="http://localhost:8080"
EVOLUTION_API_KEY="lifeline-secret-key"
EVOLUTION_INSTANCE="lifeline"
WHATSAPP_TO_NUMBER="91XXXXXXXXXX"  # Digits only with country code

